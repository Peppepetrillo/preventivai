# Supabase Cloud (già usati per sync)
# PROJECT-REF = parte host di https://<PROJECT-REF>.supabase.co
# Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://<PROJECT-REF>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Endpoint pubblico Edge Function AI (NO secret OpenAI).
# Valore consigliato (sostituisci PROJECT-REF):
# VITE_AI_ASSISTANT_ENDPOINT=https://<PROJECT-REF>.supabase.co/functions/v1/analisi-preventivo-intelligence
#
# Se lasci vuoto ma VITE_SUPABASE_URL è impostato, il client deriva lo stesso path.
# Se entrambi vuoti → solo fallback deterministico (Sprint 20).
#
# Secret OPENAI_API_KEY / OPENAI_MODEL: SOLO su Supabase Dashboard → Edge Functions → Secrets
# (oppure: supabase secrets set OPENAI_API_KEY=...)
# MAI in questo file, MAI in VITE_*, MAI nel bundle iOS.
VITE_AI_ASSISTANT_ENDPOINT=
